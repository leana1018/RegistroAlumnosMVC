@model IEnumerable<WebApplication1.Models.Alumno>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

<p>
    En esta tabla se muestran los datos de los alumnos registrados.
    Podés consultar el código, el nombre, la pensión y la fecha de nacimiento
    de cada alumno. La columna «Activo» indica si el alumno continúa asistiendo a clases.
</p>

<table class="table">
    <tr>
        <th>
            Código
        </th>
        <th>
            Nombre del alumno
        </th>
        <th>
            Pensión asignada
        </th>
        <th>
            Fecha de nacimiento
        </th>
        <th>
           ¿Activo?
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.codigo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.nombre)
        </td>
        <td>
           S/. @item.pension.ToString("C2")
        </td>
        <td>
            @item.fechaNacimiento.ToShortDateString()
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.activo)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
            @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
            @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
        </td>
    </tr>
}

</table>
